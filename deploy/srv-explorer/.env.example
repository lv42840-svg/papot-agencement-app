# Generate using: openssl rand -hex 32. Never commit the real .env.
SRV_SESSION_KEY=
SRV_PUBLIC_ORIGIN=https://srv.papot.app
SRV_AGENCEMENT_URL=http://127.0.0.1:3002
SRV_AGENCEMENT_COOKIE=papot_session
SRV_CONCEPT_URL=http://127.0.0.1:3001
SRV_CONCEPT_COOKIE=papot_concept_session
SRV_MAX_UPLOAD_BYTES=536870912

# Required: pin the ONLY SRV permissions administrator to their exact identity ID.
# Use the ID reported by /api/auth/identity while signed in to that account.
SRV_ADMIN_SOURCE=agencement
SRV_ADMIN_USER_ID=
SRV_ACCESS_FILE=/state/access.json
