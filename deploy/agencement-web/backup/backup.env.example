# Copier vers /etc/papot-agencement-backup.env, root:root et mode 600.
PAPOT_REPOSITORY_ROOT=/home/ubuntu/papot-agencement-app
PAPOT_DATABASE_URL=postgresql://ROLE:MOT_DE_PASSE@127.0.0.1:5432/BASE
PAPOT_BACKUP_FILES_ROOT=/srv/agencement
PAPOT_BACKUP_LOCAL_ROOT=/srv/papot-backups
# Destination HORS VPS, par exemple un depot SFTP ou un stockage S3.
RESTIC_REPOSITORY=sftp:utilisateur@serveur-externe:/sauvegardes/agencement
RESTIC_PASSWORD_FILE=/etc/papot-agencement-restic-password
