# Copier vers deploy/agencement-web/.env directement sur le VPS.
# Ne jamais committer le vrai fichier .env.

PAPOT_DATABASE_URL=postgresql://papot_agencement:CHANGE_ME@papot-postgres:5432/papot_agencement
PAPOT_DATABASE_APPLICATION_NAME=papot-agencement-web

# Le runtime VPS utilise PostgreSQL directement.
PAPOT_STORAGE_MODE=postgres

# Initialise une base AGENCEMENT neuve sans dépendre de Nextcloud.
# La protection refuse ce mode si des données métier existent déjà.
PAPOT_POSTGRES_BOOTSTRAP_MODE=fresh

SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=papot_agencement_session
