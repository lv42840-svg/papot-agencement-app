# Copier vers deploy/agencement-web/.env directement sur le VPS.
# Ne jamais committer le vrai fichier .env.

PAPOT_DATABASE_URL=postgresql://papot_agencement:CHANGE_ME@papot-postgres:5432/papot_agencement
PAPOT_DATABASE_APPLICATION_NAME=papot-agencement-web

# Le runtime VPS utilise PostgreSQL directement.
PAPOT_STORAGE_MODE=postgres

# Initialise une base AGENCEMENT neuve directement dans PostgreSQL.
# La protection refuse ce mode si des données métier existent déjà.
PAPOT_POSTGRES_BOOTSTRAP_MODE=fresh

# Racine des fichiers métier AGENCEMENT sur le VPS.
PAPOT_SERVER_FILES_ROOT=/srv/agencement

# Générer sur le VPS : openssl rand -hex 32
PAPOT_BOOTSTRAP_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET

SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=papot_agencement_session

# Envoi automatique des devis par e-mail.
# Même configuration SMTP que PAPOT CONCEPT.
PAPOT_SMTP_HOST=smtp.example.com
PAPOT_SMTP_PORT=587
PAPOT_SMTP_SECURE=false
PAPOT_SMTP_USERNAME=noreply@papot.app
PAPOT_SMTP_PASSWORD=CHANGE_ME

PAPOT_QUOTE_FROM_EMAIL=noreply@papot.app
PAPOT_QUOTE_CC_EMAIL=contact@papot.eu
PAPOT_QUOTE_REPLY_TO_EMAIL=contact@papot.eu
