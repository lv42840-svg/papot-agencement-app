agencement.papot.app {
    encode zstd gzip
    # Deux routes exclusives : l'API cron ne doit jamais être proxifiée sur HTTPS public.
    @internalApi path /api/internal/*
    handle @internalApi {
        respond 404
    }
    handle {
        reverse_proxy 127.0.0.1:3002 {
            header_up X-Papot-Client-IP {remote_host}
        }
    }
}
