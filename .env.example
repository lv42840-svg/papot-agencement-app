# PostgreSQL remains reachable only from the PAPOT application/server network.
DATABASE_URL=postgresql://papot_app:change-me@127.0.0.1:5432/papot_agencement

# Cookie/session settings
SESSION_COOKIE_NAME=papot_session
SESSION_TTL_HOURS=12

# One-time bootstrap values. Never commit real credentials.
BOOTSTRAP_ADMIN_NAME=Lucien
BOOTSTRAP_ADMIN_EMAIL=lucien@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-running
