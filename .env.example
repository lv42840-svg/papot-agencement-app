# Cookie/session settings
SESSION_COOKIE_NAME=papot_session
SESSION_TTL_HOURS=12

# PAPOT PostgreSQL database
PAPOT_DATABASE_URL=

# Server-side business file storage
PAPOT_SERVER_FILES_ROOT=

# Pennylane V2 (disabled until explicitly approved)
PAPOT_PENNYLANE_ENABLED=false
# Generate privately on VPS: openssl rand -base64 32
PAPOT_PENNYLANE_ENCRYPTION_KEY=

# PAPOT native invoice emission: disabled until legal/functional sign-off.
# Requires billing.issue_invoices special permission. No automatic Pennylane/e-invoice submission.
PAPOT_NATIVE_BILLING_ISSUANCE_ENABLED=false
# Credit notes have an additional independent rollout and special permission.
PAPOT_NATIVE_CREDIT_NOTES_ENABLED=false

# Isolated, deletable billing simulations. Enable only for named testers.
# Separate permissions: billing.test_sandbox and billing.reset_test_sandbox.
# It never enables real issuance, writes to Pennylane, or deletes legal archives.
PAPOT_BILLING_TEST_SANDBOX_ENABLED=false
