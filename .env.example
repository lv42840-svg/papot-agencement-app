# Cookie/session settings
SESSION_COOKIE_NAME=papot_session
SESSION_TTL_HOURS=12

# Future central PAPOT PostgreSQL database. It is dormant until server-side code calls it.
PAPOT_DATABASE_URL=

# Nextcloud transport. Keep real credentials only in local environment files or secure storage.
NEXTCLOUD_BASE_URL=https://cloud.ideo-solutions.com
NEXTCLOUD_LOGIN=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_SYNC_ROOT=PAPOT_SYNC
