{
  "name": "papot-agencement-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "nextcloud:probe": "tsx scripts/nextcloud-probe.ts",
    "sync:once": "tsx scripts/sync-worker.ts",
    "sync:worker": "tsx scripts/sync-worker.ts --watch"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.5.24",
    "pg": "8.13.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.24",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "wrangler": "4.131.1"
  }
}
