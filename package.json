{
  "name": "papot-agencement-app",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write src/lib/quotes/pricing-integrity.ts && git diff -- src/lib/quotes/pricing-integrity.ts && false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "nextcloud:probe": "tsx scripts/nextcloud-probe.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.5.24",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.24",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.23.1": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260911.1": true
  },
  "build": {
    "appId": "fr.papot.agencement",
    "productName": "PAPOT AGENCEMENT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/vendor_node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static"
      },
      {
        "from": "public",
        "to": "server/public"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/papot-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PAPOT AGENCEMENT"
    }
  }
}
